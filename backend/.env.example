# MongoDB Atlas connection string.
# Get this from Atlas -> your cluster -> Connect -> Drivers -> copy the
# connection string, then swap in your database user's password and add
# a database name before the "?". Example shape:
# mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pyramid?retryWrites=true&w=majority
DATABASE_URL="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pyramid?retryWrites=true&w=majority"

# Any long random string — used to sign JWTs.
JWT_SECRET="replace-with-a-long-random-string"

# Comma-separated list of allowed frontend origins for CORS.
FRONTEND_URL="http://localhost:3000"

# Port the API listens on.
PORT=4000

# --- Google OAuth (optional) ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must match GOOGLE_CALLBACK_URL below.
# "Login with Google" simply won't work until these are set — guest login
# does not need them.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"
